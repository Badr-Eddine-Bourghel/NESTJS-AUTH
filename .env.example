# The URL link for my postgresql DATABASE generated with Neon.
DATABASE_URL=postgresql..

# The JWT_ACCESS_SECRET is a secret string used to creat the JWT_ACCESS_TOKEN (= [User info (payload)] + [JWT_ACCESS_SECRET]) for each user and 
# it will be stored in user's browser.
# to generate one use : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=secret 

# The JWT_REFRESH_TOKEN is a secret string used to create the JWT_REFRESH_TOKEN (= [User info (payload)] + [JWT_REFRESH_SECRET]) for each user and
# also will be stored in user's browser.
# to generate one use : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=another_secret

# The date for the JWT_ACCESS_TOKEN to expires in our case is 15 minutes, which means that JWT_ACCESS_TOKEN generated for each user will expires in 15m so the user 
# the JWT_REFRESH_TOKEN to refresh his JWT_ACCESS_TOKEN
JWT_ACCESS_EXPIRES_IN=15m

# The date for the JWT_REFRESH_TOKEN to expires in our case is 7 days.
JWT_REFRESH_EXPIRES_IN=7d

# The API KEY generated by resend to send emails to my email for test, we can create a domain to send emails to any other user.
# You can generate one in https://resend.com.
RESEND_API_KEY=re_...


APP_URL=http://localhost:3000
PORT=3000
